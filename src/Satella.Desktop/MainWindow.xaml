<Window x:Class="Satella.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Satella AD Studio — Сделано командой Crazy Monkeys"
        Icon="pack://application:,,,/monkey.ico"
        Height="900"
        Width="1520"
        MinHeight="680"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0A0D0C">
    <Grid Background="#0A0D0C">
        <wv2:WebView2 x:Name="BrowserView" DefaultBackgroundColor="#FF0A0D0C" />
        <Border x:Name="LoadingOverlay" Background="#0A0D0C" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SATELLA AD STUDIO" Foreground="#F1F5F3" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Сделано командой Crazy Monkeys" Foreground="#34D399" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Инициализация ядра Active Directory..." Foreground="#94A39B" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
