<Window x:Class="Satella.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Satella AD Studio — Сделано командой Crazy Monkeys"
        Icon="pack://application:,,,/monkey.ico"
        Height="900"
        Width="1520"
        MinHeight="680"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#030805">
    <Grid Background="#030805">
        <wv2:WebView2 x:Name="BrowserView" DefaultBackgroundColor="#FF030805" />
        <Border x:Name="LoadingOverlay" Background="#030805" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="SATELLA AD STUDIO" Foreground="#10B981" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Сделано командой Crazy Monkeys" Foreground="#6EE7B7" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Инициализация ядра Active Directory..." Foreground="#22C55E" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
